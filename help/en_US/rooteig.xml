  <refnamediv>
    <refname>rooteig</refname>
    <refpurpose>Frequencies and power of sinusoids using eigenvector algorithm</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   w = rooteig(x,p)
   [w,pow] = rooteig(x,p)
   [f,pow] = rooteig(...,fs)
   [w,pow] = rooteig(...,'corr')
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>x :</term>
            <listitem><para> int|double - vector|matrix</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>p :</term>
            <listitem><para> int|double - scalar|2 element vector</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>fs :</term>
            <listitem><para> int|double - scalar</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>'corr' :</term>
            <listitem><para> flag</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>w :</term>
            <listitem><para> double - vector</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>pow :</term>
            <listitem><para> double - vector</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
// 3 complex exponentials:

n=0:99;
s=exp(1i*pi/2*n)+2*exp(1i*pi/4*n)+exp(1i*pi/3*n)+rand(1,100,'normal');
[W,P] = rooteig(s,3)


   ]]></programlisting>
</refsection>

