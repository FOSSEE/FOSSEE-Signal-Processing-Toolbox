  <refnamediv>
    <refname>ss2sos</refname>
    <refpurpose>Converts a state-space representation of a given digital filter to an equivalent second-order section representation.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   [sos, g] = ss2sos(A, B, C, D)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>a:</term>
            <listitem><para> State-space matrix A.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>b:</term>
            <listitem><para> State-space matrix B.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>c:</term>
            <listitem><para> State-space matrix C.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>d:</term>
            <listitem><para> State-space matrix D.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>sos:</term>
            <listitem><para> Second-order sections matrix.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>g:</term>
            <listitem><para> Overall system gain.</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Description</title>
   <para>
This function converts state-space representation to second-order sections.
   </para>
   <para>
</para>
</refsection>

