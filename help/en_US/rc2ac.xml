  <refnamediv>
    <refname>rc2ac</refname>
    <refpurpose>Convert reflection coefficients to autocorrelation sequence.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   a = rc2ac(k, R0)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>k:</term>
            <listitem><para> input argument reflection coefficients.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>R0:</term>
            <listitem><para> input argument zero lag autocorrelation</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>R:</term>
            <listitem><para> return  autocorrelation sequence.</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
// Example: Convert reflection coefficients to autocorrelation sequence
// Reflection coefficients
k = [0.8, -0.5, 0.3]
// Zero lag autocorrelation
R0 = 1
// Convert reflection coefficients to autocorrelation sequence
R = rc2ac(k, R0)
   ]]></programlisting>
</refsection>

