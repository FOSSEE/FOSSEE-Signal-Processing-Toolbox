  <refnamediv>
    <refname>pchips</refname>
    <refpurpose>Internal helper for main function pchip.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   v = pchip(x, y)
   v = pchip(x, y, xx)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>x:</term>
            <listitem><para> A vector of input data points.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>y:</term>
            <listitem><para> A vector or matrix of function values at the points in `x`. If `y` is a vector, it must have the same length as `x`. If `y` is a matrix, the last dimension of `y` must equal the length of `x`.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>xx:</term>
            <listitem><para> (optional) Points for interpolation.</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

