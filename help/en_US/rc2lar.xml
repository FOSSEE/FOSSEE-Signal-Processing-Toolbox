  <refnamediv>
    <refname>rc2lar</refname>
    <refpurpose>Convert  reflection coefficient to log area ratios.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   g = rc2lar(k)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>k:</term>
            <listitem><para> define the reflection coefficients.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>g:</term>
            <listitem><para> returns log area ratios.</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
X = [0.5 0.3 0.8 0.9 0.4 0.05];
g = rc2lar(X)

   ]]></programlisting>
</refsection>

