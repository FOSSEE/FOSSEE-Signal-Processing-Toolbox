  <refnamediv>
    <refname>bartlett</refname>
    <refpurpose>Generate a Bartlett window.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   w = bartlett(L)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>L:</term>
            <listitem><para> Positive integer. Length of the Bartlett window.</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Description</title>
   <para>
This function generates an L-point Bartlett window and returns it as a column vector `w`.
   </para>
   <para>
</para>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
w = bartlett(4)

   ]]></programlisting>
</refsection>

