  <refnamediv>
    <refname>morlet</refname>
    <refpurpose>Compute the Morlet wavelet.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   [psi,x]= morlet(lb,ub,n)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>lb:</term>
            <listitem><para> Real or complex valued vector/scalar</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>ub:</term>
            <listitem><para> Real or complex valued vector/scalar</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>n:</term>
            <listitem><para> Real positive scalar number</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Description</title>
   <para>
This function returns values of the Morlet wavelet in the specified interval for all the sample points.
   </para>
   <para>
</para>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
[a,b] = morlet([1 2 3], [1 2 3], 1)

   ]]></programlisting>
</refsection>
