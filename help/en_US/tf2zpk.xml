  <refnamediv>
    <refname>tf2zpk</refname>
    <refpurpose>Converts transfer function filter parameters to zero-pole-gain form</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   [z,p,k] = tf2zpk(b,a)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>z :</term>
            <listitem><para> zeros of the corrsponding tf</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>p :</term>
            <listitem><para> poles of the corresponding tf</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>k :</term>
            <listitem><para> gain of the tf</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>b :</term>
            <listitem><para> vector containing the numerator coefficients of the transfer function in descending powers of s</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>a :</term>
            <listitem><para> vector containing the denominator coefficients of the transfer function in descending powers of s</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
// Convert transfer function to zero-pole-gain form
// Define the numerator and denominator coefficients of the transfer function
num = [1, -3, 2] // Coefficients of s^2 - 3s + 2
den = [1, -2, 1] // Coefficients of s^2 - 2s + 1
// Convert to zero-pole-gain form
[z, p, k] = tf2zpk(num, den)

   ]]></programlisting>
</refsection>

