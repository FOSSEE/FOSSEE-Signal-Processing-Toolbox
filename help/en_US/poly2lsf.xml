  <refnamediv>
    <refname>poly2lsf</refname>
    <refpurpose>poly2lsf Prediction polynomial to line spectral frequencies.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   lsf = poly2lsf(a)
   
   </synopsis>
</refsynopsisdiv>

<refsection>
   <title>Parameters</title>
   <variablelist>
        <varlistentry>
            <term>k:</term>
            <listitem><para> define the prediction polynomial.</para></listitem>
        </varlistentry>
        <varlistentry>
            <term>lsf:</term>
            <listitem><para> returns corresponding line spectral frequencies.</para></listitem>
        </varlistentry>
   </variablelist>
</refsection>

<refsection>
   <title>Examples</title>
   <programlisting role="example"><![CDATA[
