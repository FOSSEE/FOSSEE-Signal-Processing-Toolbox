  <refnamediv>
    <refname>zp2ss</refname>
    <refpurpose>Converts zeros / poles to state space.</refpurpose>
  </refnamediv>


<refsynopsisdiv>
   <title>Syntax</title>
   <synopsis>
   [a, b, c, d] = zp2ss (z, p, k)
   [a, b, c] = zp2ss (z, p, k)
   [a, b] = zp2ss (z, p, k)
   a = zp2ss (z, p, k)
   
   </synopsis>
</refsynopsisdiv>

